    </owl:ObjectProperty>
    


    <!-- https://purl.org/faireo#anomaly -->

    <owl:ObjectProperty rdf:about="https://purl.org/faireo#anomaly">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://purl.org/faireo#AI_EOTrainingData"/>
                    <rdf:Description rdf:about="https://purl.org/faireo#AI_EOTrainingDataset"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="https://purl.org/faireo#EO_anomaly"/>
    </owl:ObjectProperty>
    


