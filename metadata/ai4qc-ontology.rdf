    <owl:Ontology rdf:about="https://purl.org/faireo">
        <owl:versionInfo>1.0</owl:versionInfo>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    </owl:Ontology>



    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // New Datatype Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    <!-- New Datatype Properties for Spatial Resolution Range -->
    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#spatialResolutionInMeters_min">
        <rdfs:label xml:lang="en">Spatial Resolution (min)</rdfs:label>
        <rdfs:comment xml:lang="en">The minimum value for the spatial resolution in meters.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#spatialResolutionInMeters_max">
        <rdfs:label xml:lang="en">Spatial Resolution (max)</rdfs:label>
        <rdfs:comment xml:lang="en">The maximum value for the spatial resolution in meters.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- New Datatype Properties for Byte Size Range -->
    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#byteSize_min">
        <rdfs:label xml:lang="en">Byte Size (min)</rdfs:label>
        <rdfs:comment xml:lang="en">The minimum value for the byte size.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#byteSize_max">
        <rdfs:label xml:lang="en">Byte Size (max)</rdfs:label>
        <rdfs:comment xml:lang="en">The maximum value for the byte size.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <!-- Redefine DCAT properties to use string ranges to hold original values -->
    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#spatialResolutionInMeters">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Holds the original string for spatial resolution, which may be a range or inequality.</rdfs:comment>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#byteSize">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>Holds the original string for byte size, which may contain units or be a range.</rdfs:comment>
    </owl:DatatypeProperty>
    



