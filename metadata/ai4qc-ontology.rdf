    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://purl.org/faireo#AI_AbstractLabel -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_AbstractLabel">
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_EOTask -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_EOTask">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_Task"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_EOTrainingData -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_EOTrainingData">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_TrainingData"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#datatime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#extent"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_EOTrainingDataset -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_EOTrainingDataset">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_TrainingDataset"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#band"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#Band"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#extent"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_Labeler -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_Labeler">
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_Labeling -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_Labeling">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#scope"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_LabelingProcedure -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_LabelingProcedure">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#method"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#Labeling_method"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#tools"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_MetricsInLiterature -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_MetricsInLiterature">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#literature_metric"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#LiteratureMetric"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#algorithm"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>should have doi, algorithm and metrics as data properties</rdfs:comment>
        <rdfs:definition>AI_MetricsInLiterature records results of performance metrics achieved
by AI/ML algorithms in the peer-reviewed literature.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_ObjectLabel -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_ObjectLabel">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_AbstractLabel"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#has_class"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#AI_class"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#object"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#Feature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#bboxType"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#datatime"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_PixelLabel -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_PixelLabel">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_AbstractLabel"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_SceneLabel -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_SceneLabel">
        <rdfs:subClassOf rdf:resource="https://purl.org/faireo#AI_AbstractLabel"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_Task -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_Task">
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_TrainingData -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_TrainingData">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#dataSource"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_TrainingDataset -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_TrainingDataset">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dcat#Dataset"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#has_class"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#AI_class"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#metricsInLIT"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#AI_MetricsInLiterature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#statisticsInfo"/>
                <owl:someValuesFrom rdf:resource="https://purl.org/faireo#Statistic"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#dataSource"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://purl.org/faireo#scope"/>
                <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:Class>
    


    <!-- https://purl.org/faireo#AI_class -->

    <owl:Class rdf:about="https://purl.org/faireo#AI_class">
