    <!-- http://www.w3.org/ns/dqv#hasQualityMeasurement -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dqv#hasQualityMeasurement">
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dqv#inDimension -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dqv#inDimension">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dqv#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#Dimension"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/dqv#isMeasurementOf -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/dqv#isMeasurementOf">
        <rdfs:range rdf:resource="http://www.w3.org/ns/dqv#Metric"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/odrl/2/hasPolicy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/odrl/2/hasPolicy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/odrl/2/Asset"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/odrl/2/Policy"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#used -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#used">
        <owl:inverseOf rdf:resource="http://www.w3.org/ns/prov#wasUsedBy"/>
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Activity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/ns/prov#wasUsedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/ns/prov#wasUsedBy">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/prov#Entity"/>
        <rdfs:range rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    </owl:ObjectProperty>
    


    <!-- http://xmlns.com/foaf/0.1/homepage -->

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/homepage"/>
    


    <!-- http://xmlns.com/foaf/0.1/page -->

    <owl:ObjectProperty rdf:about="http://xmlns.com/foaf/0.1/page"/>
    


