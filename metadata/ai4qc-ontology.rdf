    <!-- https://purl.org/faireo#algorithm -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#algorithm">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#amountOfTrainingData -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#amountOfTrainingData">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_TrainingDataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#area -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#area">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#bbox -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#bbox">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#bboxType -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#bboxType">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_ObjectLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:definition>Type of the bbox.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#classificationSchema -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#classificationSchema">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_TrainingDataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#confidance -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#confidance">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_AbstractLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
        <rdfs:definition>Confidence score of the labeler.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#dataSource -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#dataSource">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#datatime -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#datatime">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#doi -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#doi">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#extent -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#extent">
        <rdfs:definition>Spatial extent of the EO training dataset.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#image_format -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#image_format">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_PixelLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:definition>Image data format.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#image_size -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#image_size">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_EOTrainingDataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#image_size_x -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#image_size_x">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#image_size_y -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#image_size_y">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#image_url -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#image_url">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_PixelLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anyURI"/>
        <rdfs:definition>URL of the images representing the label
information.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#isNegative -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#isNegative">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_AbstractLabel"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:definition>Whether the training sample related to the
label is a positive or negative sample.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#iscrowd -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#iscrowd">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#numberOfClasses -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#numberOfClasses">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_TrainingDataset"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#numberOfLabels -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#numberOfLabels">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_TrainingData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#int"/>
        <rdfs:definition>Total number of labels in the individual AI
training sample.</rdfs:definition>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#scope -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#scope">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#taskType -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#taskType">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_Task"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#tools -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#tools">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:isDefinedBy>TDS</rdfs:isDefinedBy>
    </owl:DatatypeProperty>
    


    <!-- https://purl.org/faireo#trainingType -->

    <owl:DatatypeProperty rdf:about="https://purl.org/faireo#trainingType">
        <rdfs:domain rdf:resource="https://purl.org/faireo#AI_TrainingData"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment>e.g., &quot;training&quot;</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://purl.org/dc/terms/issued -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/issued">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/adms#versionNotes -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/adms#versionNotes">
        <rdfs:domain rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dcat#byteSize -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#byteSize">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dcat#Distribution"/>
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dcat#keyword -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#keyword">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dcat#spatialResolutionInMeters -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#spatialResolutionInMeters">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dcat#temporalResolution -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#temporalResolution">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#duration"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dcat#version -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dcat#version">
        <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dqv#expectedDataType -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dqv#expectedDataType">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dqv#Metric"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3.org/ns/dqv#value -->

    <owl:DatatypeProperty rdf:about="http://www.w3.org/ns/dqv#value">
        <rdfs:domain rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    </owl:DatatypeProperty>
    


