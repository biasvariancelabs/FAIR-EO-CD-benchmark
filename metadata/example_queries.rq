# FAIR-EO example SPARQL queries (run against schema + generated run instances)
PREFIX feo:  <http://w3id.org/fair-eo#>
PREFIX it6:  <http://data.europa.eu/it6/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX ai4qc: <https://purl.org/faireo#>

# 1) Leaderboard: macro-F1 on the test split, per model + dataset
SELECT ?model ?dataset ?f1 WHERE {
  ?run it6:realizes ?m ; feo:onDataset ?d ; feo:hasEvaluationResult ?er .
  ?m feo:modelType ?model . ?d owl:sameAs/dct:title ?dataset .
  ?er feo:hasMeasure feo:F1Score ; feo:hasAggregation feo:Macro ;
      feo:onSplit feo:TestSplit ; feo:value ?f1 .
} ORDER BY DESC(?f1)

