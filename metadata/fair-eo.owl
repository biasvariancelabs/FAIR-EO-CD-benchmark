  <rdf:Description rdf:about="http://w3id.org/fair-eo#EvaluationMeasureScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">FAIR-EO evaluation measures</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#batchSize">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">batch size</rdfs:label>
    <rdfs:domain rdf:resource="http://data.europa.eu/it6/Run"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#hasLabelSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">has label set</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/fair-eo#EODataset"/>
    <rdfs:range rdf:resource="http://w3id.org/fair-eo#EOLabelSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/faireo#algorithm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">algorithm</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:isDefinedBy rdf:resource="https://purl.org/faireo#"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#basedOnMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">based on method</rdfs:label>
    <rdfs:domain rdf:resource="http://data.europa.eu/it6/MachineLearningModel"/>
    <rdfs:range rdf:resource="http://w3id.org/fair-eo#Method"/>
    <rdfs:comment xml:lang="en">Links the trained model produced by a run to its catalogued method/architecture.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://purl.org/faireo#Statistic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Statistic</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://purl.org/faireo#"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#ResourceEstimate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Resource Estimate</rdfs:label>
    <rdfs:comment xml:lang="en">Computational-cost estimates of a run (Green-AI accounting).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#EvaluationResult">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evaluation Result</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/dqv#QualityMeasurement"/>
    <rdfs:comment xml:lang="en">A single measured metric value for a run: base measure x aggregation x split (+ optional detection qualifiers).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://xmlns.com/foaf/0.1/Person">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Person</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://xmlns.com/foaf/0.1/Agent"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#modelType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">model type</rdfs:label>
    <rdfs:domain rdf:resource="http://data.europa.eu/it6/MachineLearningModel"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Model architecture name (MLflow 'model_type' tag), e.g. AlexNet, ATSS, BIT.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/it6/MachineLearningModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Machine Learning Model</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#ObjectScale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Object Scale</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#MeanAverageRecall">
    <rdf:type rdf:resource="http://data.europa.eu/it6/EvaluationMeasure"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://w3id.org/fair-eo#EvaluationMeasureScheme"/>
    <skos:prefLabel xml:lang="en">Mean average recall (mAR)</skos:prefLabel>
    <skos:notation>mar</skos:notation>
    <feo:appliesToTaskType rdf:resource="http://w3id.org/fair-eo#ObjectDetection"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#ModelType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Model Type</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#availableInGitHub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">available on GitHub</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/fair-eo#Method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#priority">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">benchmark priority</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/fair-eo#Method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Benchmarking priority tier (1 = highest), from the priority list.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#Foundation">
    <rdf:type rdf:resource="http://w3id.org/fair-eo#ModelType"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <skos:inScheme rdf:resource="http://w3id.org/fair-eo#ModelTypeScheme"/>
    <skos:prefLabel xml:lang="en">Foundation</skos:prefLabel>
    <skos:notation>Foundation</skos:notation>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#ModelFamilyScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Foundation-model families</skos:prefLabel>
    <rdfs:comment xml:lang="en">Concepts populated from the foundation-model spreadsheet (SatMAE, MoCo, DINO, Prithvi, ...).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/it6/Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Feature</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/it6/TaskType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Task Type</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#maxEpochs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">max epochs</rdfs:label>
    <rdfs:domain rdf:resource="http://data.europa.eu/it6/Run"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/it6/FlowParameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Flow Parameter</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#pretrainedWeightsAvailable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">pretrained weights available</rdfs:label>
    <rdfs:domain rdf:resource="http://w3id.org/fair-eo#Method"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://data.europa.eu/it6/Prediction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prediction</rdfs:label>
    <rdfs:isDefinedBy rdf:resource="https://semiceu.github.io/MLDCAT-AP/releases/2.0.0/"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#AggregationScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <skos:prefLabel xml:lang="en">Metric aggregations</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#runId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">run id</rdfs:label>
    <rdfs:domain rdf:resource="http://data.europa.eu/it6/Run"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://w3id.org/fair-eo#Aggregation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aggregation</rdfs:label>
    <rdfs:comment xml:lang="en">How a per-class metric is aggregated across classes.</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
