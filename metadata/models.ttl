:bit a feo:Method ;
    rdfs:label "BIT" ;
    dct:title "BIT" ;
    feo:availableInAiTLAS true ;
    feo:availableInGitHub true ;
    feo:availableInTimm false ;
    feo:availableInTorchvision false ;
    feo:hasArchitecture <http://w3id.org/fair-eo/vocab/architecture/ResNet> ;
    feo:modelCategory feo:Traditional ;
    feo:supportsTaskType feo:ChangeDetection .

