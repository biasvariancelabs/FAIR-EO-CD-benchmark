:seasonvaryingcdd a ai4qc:AI_EOTrainingDataset ;
    ai4qc:amountOfTrainingData 16000 ;
    ai4qc:band [ a ai4qc:Band ;
            rdfs:label "B1" ;
            ns1:value "Red (600-700nm)" ],
        [ a ai4qc:Band ;
            rdfs:label "B3" ;
            ns1:value "Blue (400-450nm)" ],
        [ a ai4qc:Band ;
            rdfs:label "B2" ;
            ns1:value "Green (500-600nm)" ] ;
    ai4qc:dataSource "Google Earth" ;
    ai4qc:has_class [ a ai4qc:AI_class ;
            rdfs:label "no change" ;
            dct:identifier 0 ],
        [ a ai4qc:AI_class ;
            rdfs:label "change" ;
            dct:identifier 1 ] ;
    ai4qc:has_task [ a ai4qc:AI_EOTask ;
            it6:hasTaskType feo:ChangeDetection ;
            ai4qc:taskType "change detection" ;
            dct:description "Change detection with a segmentation mask assigned to a pair of images." ;
            dct:identifier "season_varying_cdd-AItask" ] ;
    ai4qc:image_size "256 x 256" ;
    ai4qc:labeling [ a ai4qc:AI_Labeling ;
            ai4qc:labeler [ a ai4qc:AI_Labeler ;
                    dct:identifier "season_varying_cdd-labeler_1" ;
                    foaf:name "M. A. Lebedev" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "season_varying_cdd-labeler_5" ;
                    foaf:name "A. Yu. Rubis" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "season_varying_cdd-labeler_4" ;
                    foaf:name "V. A. Knyaz" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "season_varying_cdd-labeler_3" ;
                    foaf:name "O. V. Vygolov" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "season_varying_cdd-labeler_2" ;
                    foaf:name "Yu. V. Vizilter" ] ;
            ai4qc:procedure [ a ai4qc:AI_LabelingProcedure ;
                    ai4qc:method [ rdfs:label "labels" ;
                            ai4qc:definition "Ground truths were labeled manually using very high resolution imagery." ] ;
                    ai4qc:scope "Labeling of all pixels with change or no change, the full scene is classified." ;
                    dct:identifier "season_varying_cdd-labeling-procedure" ] ;
            dct:identifier "season_varying_cdd-labeling" ] ;
    ai4qc:metricsInLIT [ a ai4qc:AI_MetricsInLiterature ;
            ai4qc:algorithm "MDNet" ;
            ai4qc:literature_metric [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Recall" ;
                    ns1:value "0.957" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "IoU" ;
                    ns1:value "0.925" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "F1-score" ;
                    ns1:value "0.961" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Precision" ;
                    ns1:value "0.965" ] ;
            dct:identifier "doi.org/10.3390/rs15143482" ],
        [ a ai4qc:AI_MetricsInLiterature ;
            ai4qc:algorithm "GAN" ;
            ai4qc:literature_metric [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Precision" ;
                    ns1:value "0.91" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Recall" ;
                    ns1:value "0.87" ] ;
            dct:identifier "doi.org/10.5194/isprs-archives-XLII-2-565-2018" ],
        [ a ai4qc:AI_MetricsInLiterature ;
            ai4qc:algorithm "SMCDNet" ;
            ai4qc:literature_metric [ a ai4qc:LiteratureMetric ;
                    rdfs:label "F1-score" ;
                    ns1:value "0.953" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Precision" ;
                    ns1:value "0.946" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "IoU" ;
                    ns1:value "0.910" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Recall" ;
                    ns1:value "0.960" ] ;
            dct:identifier "doi.org/10.3390/rs15143482" ] ;
    ai4qc:numberOfClasses 2 ;
    ai4qc:scope "The dataset contains season-varying remote sensing images of the same region." ;
    ai4qc:statisticsInfo [ a ai4qc:Statistic ;
            rdfs:label "number of image patches" ;
            ns1:value "16000" ] ;
    dct:created "2018-06-04" ;
    dct:creator "State Res. Institute of Aviation Systems (GosNIIAS)" ;
    dct:description "As a common dataset for change detection, the dataset contains three parts: the image before the change, the image after the change, and the label image showing the changed area. This dataset is characterized by significant seasonal differences between bi-temporal image pairs. The labels for this dataset include some irregular changes, such as the appearance and disappearance of cars; but do not include seasonal changes, such as changes in the ground surface caused by snowfall." ;
    dct:identifier "season_varying_cdd" ;
    dct:license "Unknown" ;
    dct:publisher "State Res. Institute of Aviation Systems (GosNIIAS)" ;
    dct:title "Season-varying Change Detection dataset" ;
    dcat:distribution [ a dcat:Distribution ;
            dcatap:availability [ ns1:value "available" ] ;
            ai4qc:page [ ns1:value "https://drive.google.com/file/d/1GX656JqqOyBi_Ef0w65kDGVto-nHrNs9" ] ;
            ai4qc:representationTechnique [ ns1:value "JPG" ] ;
            ai4qc:status [ ns1:value "completed" ] ;
            dct:description "The dataset is distributed in a zip file format. The 'real' folder contains the Season-varying Change Detection Dataset. It contains both the original dataset (11 images of varying sizes) as well as the modified dataset with 16000 images divided into train/val/test splits. Images at time 1, 2 and labels are in jpg format." ;
