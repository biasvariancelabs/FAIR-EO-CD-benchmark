:bandon a ai4qc:AI_EOTrainingDataset ;
    ai4qc:amountOfTrainingData 2283 ;
    ai4qc:band [ a ai4qc:Band ;
            rdfs:label "B1" ;
            ns1:value "Red (600-700nm)" ],
        [ a ai4qc:Band ;
            rdfs:label "B3" ;
            ns1:value "Blue (400-450nm)" ],
        [ a ai4qc:Band ;
            rdfs:label "B2" ;
            ns1:value "Green (500-600nm)" ] ;
    ai4qc:dataSource "Aerial" ;
    ai4qc:has_class [ a ai4qc:AI_class ;
            rdfs:label "change" ;
            dct:identifier 1 ],
        [ a ai4qc:AI_class ;
            rdfs:label "no change" ;
            dct:identifier 0 ] ;
    ai4qc:has_task [ a ai4qc:AI_EOTask ;
            it6:hasTaskType feo:ChangeDetection ;
            ai4qc:taskType "change detection" ;
            dct:description "Change detection with a segmentation mask assigned to a pair of images." ;
            dct:identifier "bandon-AItask" ] ;
    ai4qc:image_size "2048 x 2048" ;
    ai4qc:labeling [ a ai4qc:AI_Labeling ;
            ai4qc:labeler [ a ai4qc:AI_Labeler ;
                    dct:identifier "bandon-labeler_4" ;
                    foaf:name "Can Song" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "bandon-labeler_3" ;
                    foaf:name "Jian Ding" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "bandon-labeler_5" ;
                    foaf:name "Gui-Song Xia" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "bandon-labeler_1" ;
                    foaf:name "Chao Pang" ],
                [ a ai4qc:AI_Labeler ;
                    dct:identifier "bandon-labeler_2" ;
                    foaf:name "Jiang Wu" ] ;
            ai4qc:procedure [ a ai4qc:AI_LabelingProcedure ;
                    ai4qc:method [ rdfs:label "labels" ;
                            ai4qc:definition "We adopted a semi-automatic labeling strategy for creating building change labels, i.e., an automatic candidate generation step followed by manual annotations." ] ;
                    ai4qc:scope "Labeling of all pixels with one of the classes, the full scene is classified." ;
                    ai4qc:tools "SenseTime API" ;
                    dct:identifier "bandon-labeling-procedure" ] ;
            dct:identifier "bandon-labeling" ] ;
    ai4qc:metricsInLIT [ a ai4qc:AI_MetricsInLiterature ;
            ai4qc:algorithm "MTGCD-Net" ;
            ai4qc:literature_metric [ a ai4qc:LiteratureMetric ;
                    rdfs:label "IoU" ;
                    ns1:value "0.6027" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Precision" ;
                    ns1:value "0.7392" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "F1" ;
                    ns1:value "0.7521" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Recall" ;
                    ns1:value "0.7655" ] ;
            dct:identifier "doi.org/10.48550/arXiv.2301.10922" ],
        [ a ai4qc:AI_MetricsInLiterature ;
            ai4qc:algorithm "Change-Mix" ;
            ai4qc:literature_metric [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Recall" ;
                    ns1:value "0.7080" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "IoU" ;
                    ns1:value "0.5389" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "Precision" ;
                    ns1:value "0.6929" ],
                [ a ai4qc:LiteratureMetric ;
                    rdfs:label "F1" ;
                    ns1:value "0.7004" ] ;
            dct:identifier "doi.org/10.48550/arXiv.2301.10922" ] ;
    ai4qc:numberOfClasses 2 ;
    ai4qc:scope "The images are geo-located in six representative cities of China, i.e., Beijing, Shanghai, Wuhan, Shenzhen, HongKong and Jinan." ;
    ai4qc:statisticsInfo [ a ai4qc:Statistic ;
            rdfs:label "number of testing image patches" ;
            ns1:value "392" ],
        [ a ai4qc:Statistic ;
            rdfs:label "number of image patches" ;
            ns1:value "2283" ],
        [ a ai4qc:Statistic ;
            rdfs:label "number of change instances" ;
            ns1:value "123000" ],
        [ a ai4qc:Statistic ;
            rdfs:label "number of training image patches" ;
            ns1:value "1689" ],
        [ a ai4qc:Statistic ;
            rdfs:label "number of validation image patches" ;
            ns1:value "202" ] ;
    dct:created "2023-09-14" ;
    dct:creator "SenseTime Research, Beijing",
        "Wuhan University" ;
    dct:description "The building change detection with off-nadir aerial images dataset (BANDON) was built to address the problem of accurate detection and localization of urban building changes from oblique drone images. The BANDON dataset contains 2283 pairs of images, 2283 change labels, 1891 BT-flows labels, 1891 pairs of segmentation labels, and 1891 pairs of ST-offsets labels (test sets do not provide auxiliary annotations)." ;
    dct:identifier "bandon" ;
    dct:license "Unknown" ;
    dct:publisher "Wuhan University" ;
    dct:title "Bandon dataset" ;
    dcat:distribution [ a dcat:Distribution ;
            dcatap:availability [ ns1:value "available" ] ;
            ai4qc:page [ ns1:value "https://github.com/fitzpchao/BANDON" ] ;
            ai4qc:representationTechnique [ ns1:value "PNG" ],
                [ ns1:value "JPG" ],
                [ ns1:value "TIFF" ] ;
            ai4qc:status [ ns1:value "completed" ] ;
            dct:description "The dataset is distributed in a zip file format. The archive contains train, validation and test folders. Images are available at times 1, 2 and 3, in jpg format. Corresponding building labels are available in png format. Change labels are available in 'labels_unch0ch1ig255' in png format. Other label files are in tiff format. Txt files contain the information of the change detection sample pairs." ;
            dct:format [ ns1:value "zip" ] ;
            dct:identifier "bandon-distribution" ;
            dct:issued "2023-09-14" ;
            dct:language [ ns1:value "English" ] ;
            dct:rights [ a dct:RightsStatement ;
                    ns1:value "Unknown" ] ;
            dct:title "BANDON distribution" ;
            dcat:accessService [ a dcat:DataService ;
                    ai4qc:accessRights [ a dct:RightsStatement ;
                            ns1:value "open" ] ;
                    ai4qc:landingPage [ ns1:value "https://github.com/" ] ;
                    ai4qc:subject [ ns1:value "change detection" ],
                        [ ns1:value "building change" ] ;
                    dct:created "2023-09-14" ;
                    dct:creator "SenseTime Research, Beijing",
                        "Wuhan University" ;
                    dct:description "The Data Service class provides a collection of operations that give access to the BANDON dataset." ;
                    dct:format [ ns1:value "zip" ] ;
                    dct:identifier "bandon-data-service" ;
                    dct:isReferencedBy [ ns1:value "https://arxiv.org/pdf/2301.10922" ] ;
                    dct:license "Unkown" ;
                    dct:title "BANDON data service" ;
                    dcat:contactPoint [ ns1:value "Chao Pang" ] ;
                    dcat:endpointDescription [ ns1:value "The dataset can be downloaded via the end-point." ] ;
                    dcat:endpointURL [ ns1:value "https://drive.google.com/drive/folders/1MTwbRLw76f_hThmELkLwKpfRQbkPH28P" ] ;
                    dcat:keyword "building change",
                        "change detection" ;
                    dcat:theme [ ns1:value "Deep learning" ] ;
                    dcat:version "V1" ] ;
            dcat:accessURL [ ns1:value "https://github.com/fitzpchao/BANDON" ] ;
            dcat:byteSize "4458389055" ;
            dcat:downloadURL [ ns1:value "https://drive.google.com/drive/folders/1MTwbRLw76f_hThmELkLwKpfRQbkPH28P" ] ;
            dcat:mediaType [ ns1:value "image/jpg" ],
                [ ns1:value "image/tiff" ],
                [ ns1:value "image/png" ] ;
            dcat:packageFormat [ ns1:value "application/zip" ] ;
            dcat:spatialResolutionInMeters 0.6 ;
            odrl:hasPolicy [ ns1:value "Unknown" ] ] ;
    dcat:keyword "building change",
        "change detection" ;
    dcat:version "V1" .

:clcd a ai4qc:AI_EOTrainingDataset ;
